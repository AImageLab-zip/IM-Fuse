# Copy this file to .env at the repo root and fill in both values.

# Port the runner website (src/runner) listens on. Plain HTTP for now.
MIMOSE_RUNNER_PORT=8000

# Path to the already-unpacked raw BRaTS root, e.g. a directory whose
# immediate subdirectories are case folders following
# <case_id>/<case_id>-{t1c,t1n,t2f,t2w,seg}.nii.gz. Mounted read-only into
# the preprocessing container.
MIMOSE_RUNNER_RAW_BRATS_DIR=/path/to/unpacked/brats
